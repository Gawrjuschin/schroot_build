{
    "version": 6,
    "configurePresets": [
        {
            "name": "schroot-base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/schroot-toolchain.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "arch-i686",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_TARGET_PROCESSOR": "i686"
            }
        },
        {
            "name": "arch-x86_64",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_TARGET_PROCESSOR": "x86_64"
            }
        },
        {
            "name": "arch-aarch64",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_TARGET_PROCESSOR": "aarch64"
            }
        },
        {
            "name": "debian-trixie",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_GCC_VERSION": "14",
                "SCHROOT_ROOT": "/srv/chroot/debian-trixie"
            }
        },
        {
            "name": "debian-forky",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_TARGET_PROCESSOR": "x86_64",
                "SCHROOT_GCC_VERSION": "16",
                "SCHROOT_ROOT": "/srv/chroot/debian-forky"
            }
        },
        {
            "name": "ubuntu-noble",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_TARGET_PROCESSOR": "x86_64",
                "SCHROOT_GCC_VERSION": "14",
                "SCHROOT_ROOT": "/srv/chroot/ubuntu-noble"
            }
        },
        {
            "name": "ubuntu-plucky",
            "hidden": true,
            "cacheVariables": {
                "SCHROOT_TARGET_PROCESSOR": "x86_64",
                "SCHROOT_GCC_VERSION": "15",
                "SCHROOT_ROOT": "/srv/chroot/ubuntu-plucky"
            }
        },
        {
            "name": "debian-trixie-x86_64-config",
            "displayName": "Configure Debian 13 Trixie x86_64",
            "inherits": [
                "schroot-base",
                "arch-x86_64",
                "debian-trixie"
            ]
        },
        {
            "name": "debian-forky-x86_64-config",
            "displayName": "Configure Debian 14 Forky x86_64",
            "inherits": [
                "schroot-base",
                "arch-x86_64",
                "debian-forky"
            ]
        },
        {
            "name": "ubuntu-noble-x86_64-config",
            "displayName": "Configure Ubuntu 24 Noble x86_64",
            "inherits": [
                "schroot-base",
                "arch-x86_64",
                "ubuntu-noble"
            ]
        },
        {
            "name": "ubuntu-plucky-x86_64-config",
            "displayName": "Configure Ubuntu 26 Plucky x86_64",
            "inherits": [
                "schroot-base",
                "arch-x86_64",
                "ubuntu-plucky"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "debian-trixie-x86_64-build-debug",
            "configurePreset": "debian-trixie-x86_64-config",
            "configuration": "Debug"
        },
        {
            "name": "debian-trixie-x86_64-build-release",
            "configurePreset": "debian-trixie-x86_64-config",
            "configuration": "Release"
        },
        {
            "name": "debian-forky-x86_64-build-debug",
            "configurePreset": "debian-forky-x86_64-config",
            "configuration": "Debug"
        },
        {
            "name": "debian-forky-x86_64-build-release",
            "configurePreset": "debian-forky-x86_64-config",
            "configuration": "Release"
        },
        {
            "name": "ubuntu-noble-x86_64-build-debug",
            "configurePreset": "ubuntu-noble-x86_64-config",
            "configuration": "Debug"
        },
        {
            "name": "ubuntu-noble-x86_64-build-release",
            "configurePreset": "ubuntu-noble-x86_64-config",
            "configuration": "Release"
        },
        {
            "name": "ubuntu-plucky-x86_64-build-debug",
            "configurePreset": "ubuntu-plucky-x86_64-config",
            "configuration": "Debug"
        },
        {
            "name": "ubuntu-plucky-x86_64-build-release",
            "configurePreset": "ubuntu-plucky-x86_64-config",
            "configuration": "Release"
        }
    ],
    "packagePresets": [
        {
            "name": "debian-trixie-x86_64-pack-deb",
            "displayName": "Package Debian 13 Trixie (x86_64 Release)",
            "description": "Generate .deb package for Debian 13 Trixie (x86_64 Release) using CPack",
            "configurePreset": "debian-trixie-x86_64-config",
            "generators": [
                "DEB"
            ],
            "configurations": [
                "Release"
            ]
        },
        {
            "name": "debian-forky-x86_64-pack-deb",
            "displayName": "Package Debian 14 Forky (x86_64 Release)",
            "description": "Generate .deb package for Debian 14 Forky (Release) using CPack",
            "configurePreset": "debian-forky-x86_64-config",
            "generators": [
                "DEB"
            ],
            "configurations": [
                "Release"
            ]
        },
        {
            "name": "ubuntu-noble-x86_64-pack-deb",
            "displayName": "Package Ubuntu 24 Noble (x86_64 Release)",
            "description": "Generate .deb package for Ubuntu 24 Noble (Release) using CPack",
            "configurePreset": "ubuntu-noble-x86_64-config",
            "generators": [
                "DEB"
            ],
            "configurations": [
                "Release"
            ]
        },
        {
            "name": "ubuntu-plucky-x86_64-pack-deb",
            "displayName": "Package Ubuntu 26 Plucky (x86_64 Release)",
            "description": "Generate .deb package for Ubuntu 26 Plucky (Release) using CPack",
            "configurePreset": "ubuntu-plucky-x86_64-config",
            "generators": [
                "DEB"
            ],
            "configurations": [
                "Release"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "debian-trixie-x86_64-full",
            "displayName": "Configure, Build and Pack (Debian 13 x86_64)",
            "description": "Configure, build Release, and generate DEB package in one command",
            "steps": [
                {
                    "type": "configure",
                    "name": "debian-trixie-x86_64-config"
                },
                {
                    "type": "build",
                    "name": "debian-trixie-x86_64-build-release"
                },
                {
                    "type": "package",
                    "name": "debian-trixie-x86_64-pack-deb"
                }
            ]
        },
        {
            "name": "debian-forky-x86_64-full",
            "displayName": "Configure, Build and Pack (Debian 14 x86_64)",
            "description": "Configure, build Release, and generate DEB package in one command",
            "steps": [
                {
                    "type": "configure",
                    "name": "debian-forky-x86_64-config"
                },
                {
                    "type": "build",
                    "name": "debian-forky-x86_64-build-release"
                },
                {
                    "type": "package",
                    "name": "debian-forky-x86_64-pack-deb"
                }
            ]
        },
        {
            "name": "ubuntu-noble-x86_64-full",
            "displayName": "Configure, Build and Pack (Ubuntu 24 x86_64)",
            "description": "Configure, build Release, and generate DEB package in one command",
            "steps": [
                {
                    "type": "configure",
                    "name": "ubuntu-noble-x86_64-config"
                },
                {
                    "type": "build",
                    "name": "ubuntu-noble-x86_64-build-release"
                },
                {
                    "type": "package",
                    "name": "ubuntu-noble-x86_64-pack-deb"
                }
            ]
        },
        {
            "name": "ubuntu-plucky-x86_64-full",
            "displayName": "Configure, Build and Pack (Ubuntu 26 x86_64)",
            "description": "Configure, build Release, and generate DEB package in one command",
            "steps": [
                {
                    "type": "configure",
                    "name": "ubuntu-plucky-x86_64-config"
                },
                {
                    "type": "build",
                    "name": "ubuntu-plucky-x86_64-build-release"
                },
                {
                    "type": "package",
                    "name": "ubuntu-plucky-x86_64-pack-deb"
                }
            ]
        }
    ]
}
