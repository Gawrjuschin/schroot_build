# set(CMAKE_SYSTEM_NAME Linux)
# set(CMAKE_TRY_COMPILE_TARGET_TYPE "STATIC_LIBRARY")

if(DEFINED ENV{SCHROOT_SYSROOT})
    set(SCHROOT_SYSROOT "$ENV{SCHROOT_SYSROOT}")
elseif(NOT DEFINED SCHROOT_SYSROOT)
    message(FATAL_ERROR "SCHROOT_SYSROOT is not defined! Pass it via env variable or -DSCHROOT_SYSROOT=...")
endif()

if(NOT DEFINED SCHROOT_COMPILER_C)
    set(SCHROOT_COMPILER_C "gcc")
endif()

if(NOT DEFINED SCHROOT_COMPILER_CXX)
    set(SCHROOT_COMPILER_CXX "g++")
endif()

message(STATUS "Using schroot sysroot: ${SCHROOT_SYSROOT}")

set(CMAKE_C_COMPILER "${SCHROOT_SYSROOT}/usr/bin/${SCHROOT_COMPILER_C}")
set(CMAKE_CXX_COMPILER "${SCHROOT_SYSROOT}/usr/bin/${SCHROOT_COMPILER_CXX}")

set(CMAKE_SYSROOT "${SCHROOT_SYSROOT}")

set(CMAKE_FIND_ROOT_PATH "${SCHROOT_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
