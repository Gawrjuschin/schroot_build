set(SCHROOT_ROOT
    ""
    CACHE PATH "Root directory of the schroot.")
set(SCHROOT_TARGET_PROCESSOR
    ""
    CACHE STRING "Target processor; empty for native build.")
set(SCHROOT_GCC_VERSION
    ""
    CACHE STRING "Target compiler version.")

set(SCHROOT_TARGET_TRIPLE "${SCHROOT_TARGET_PROCESSOR}-linux-gnu")

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${SCHROOT_TARGET_PROCESSOR}")

set(CMAKE_C_COMPILER
    "${SCHROOT_ROOT}/usr/bin/${SCHROOT_TARGET_TRIPLE}-gcc-${SCHROOT_GCC_VERSION}"
)
set(CMAKE_CXX_COMPILER
    "${SCHROOT_ROOT}/usr/bin/${SCHROOT_TARGET_TRIPLE}-g++-${SCHROOT_GCC_VERSION}"
)

# Use host AR and RANLIB
set(CMAKE_AR /usr/bin/ar)
set(CMAKE_RANLIB /usr/bin/ranlib)

set(CMAKE_SYSROOT "${SCHROOT_ROOT}")
set(CMAKE_FIND_ROOT_PATH "${SCHROOT_ROOT}/${SCHROOT_TARGET_TRIPLE}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
